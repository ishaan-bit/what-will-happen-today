# Analytics (PostHog)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Backend for LLM-enhanced daily predictions
EXPO_PUBLIC_API_URL=https://wwht-backend.vercel.app

# Rewarded ads
# Mock must be explicitly enabled for local/dev testing. Production never grants
# reward unless the native SDK emits an earned-reward callback.
EXPO_PUBLIC_REWARDED_AD_MOCK=false
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_SIGNAL_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_DEEPER_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_HERO_UNIT_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
