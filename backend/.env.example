# Upstash Redis — shared with TriggerMap (read from trigger-map/backend/.env)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ollama (local, same as TriggerMap)
OLLAMA_API_URL=http://localhost:11434/v1
OLLAMA_MODEL=phi3

# Cron security
CRON_SECRET=

# App URL
APP_BASE_URL=https://your-wwht-backend.vercel.app
