{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://wwht-backend.vercel.app",
        "EXPO_PUBLIC_ADMOB_TEST_MODE": "true",
        "EXPO_PUBLIC_REWARDED_AD_MOCK": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://wwht-backend.vercel.app",
        "EXPO_PUBLIC_ADMOB_TEST_MODE": "true",
        "EXPO_PUBLIC_REWARDED_AD_MOCK": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://wwht-backend.vercel.app",
        "EXPO_PUBLIC_ADMOB_TEST_MODE": "false",
        "EXPO_PUBLIC_REWARDED_AD_MOCK": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
