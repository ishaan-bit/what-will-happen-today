# Worker auth — clients (ops console) must send this as Bearer token
LOCAL_WORKER_KEY=change-me-to-a-strong-secret
LOCAL_WORKER_PORT=8788

# Upstash Redis (same credentials as backend) — for storing generated predictions
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ollama (local LLM)
OLLAMA_API_URL=http://localhost:11434/v1
OLLAMA_MODEL=phi3
OLLAMA_NUM_GPU=26
OLLAMA_NUM_CTX=8192
